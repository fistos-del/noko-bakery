generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model RawMaterial {
  id            String   @id @default(cuid())
  name          String   @unique
  currentTons   Float
  minTons       Float
  supplier      String
  leadTimeDays  Int
  lastOrderedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  npk          String
  category     String
  description  String
  primaryUse   String
  packaging    String
  pricePerTon  Float
  stockTons    Float
  minStockTons Float
  imageUrl     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  type        String
  contactName String
  phone       String
  email       String
  region      String
  address     String
  creditLimit Float    @default(0)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  status          String      @default("PENDING")
  deliveryDate    DateTime
  deliveryAddress String
  notes           String      @default("")
  totalValue      Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  quantityTons Float
  pricePerTon  Float
  subtotal     Float
}